{
  "contract_version": "1.2",
  "workflow_name": "GATE BTC Factory Shadow",
  "workflow_path": ".github/workflows/gate-btc-factory-shadow.yml",
  "mode": "PARALLEL_SHADOW_ONLY",
  "schedule_cron": "17 */6 * * *",
  "push_refresh_enabled": true,
  "manual_dispatch_enabled": true,
  "permissions": {
    "contents": "read"
  },
  "writes_repository": false,
  "uploads_artifact_only": true,
  "artifact_name_prefix": "qrds-factory-status-",
  "runner": "tools/gate_btc_factory/run_factory.py",
  "runtime_output": "tools/gate_btc_factory/FACTORY_STATUS_LATEST.json",
  "source": "tools/gate_btc_research_factory_status.json",
  "source_freshness_policy": "SOURCE_STATUS_IS_REPORTED_AS_OBSERVED; AMBIGUITY_OR_STALENESS_CANNOT_PROMOTE_OR_MUTATE_ACTIVE_TRACKS",
  "safety": {
    "RESEARCH_ONLY": true,
    "SHADOW_ONLY": true,
    "NOT_APPROVED": true,
    "ORDERS": 0,
    "REAL_CAPITAL": 0,
    "ENGINE_FEED": false
  },
  "non_interference": {
    "existing_workflow_mutation": false,
    "existing_schedule_mutation": false,
    "runtime_pointer_mutation": false,
    "existing_ledger_mutation": false,
    "clock_or_counter_mutation": false,
    "generated_status_commit": false,
    "artifact_only": true
  },
  "forbidden": [
    "commit_generated_status",
    "mutate_active_workflow",
    "mutate_existing_schedule",
    "mutate_runtime_pointer",
    "mutate_existing_ledger",
    "alter_clock_or_counter",
    "retune",
    "backfill",
    "read_partial_blind_holdout_economics",
    "orders",
    "real_capital",
    "engine_feed"
  ]
}
