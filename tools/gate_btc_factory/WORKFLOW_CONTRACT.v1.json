{
  "contract_version": "1.1",
  "workflow_name": "GATE BTC Factory Shadow",
  "workflow_path": ".github/workflows/gate-btc-factory-shadow.yml",
  "mode": "PARALLEL_SHADOW_ONLY",
  "schedule_cron": "23 * * * *",
  "push_refresh_enabled": true,
  "manual_dispatch_enabled": true,
  "permissions": {
    "contents": "read"
  },
  "writes_repository": false,
  "uploads_artifact_only": true,
  "artifact_name_prefix": "qrds-factory-shadow-status-",
  "runner": "tools/gate_btc_factory/run_factory_ci.py",
  "runtime_output": "tools/gate_btc_factory/FACTORY_STATUS_RUNTIME.json",
  "source": "tools/gate_btc_research_factory_status.json",
  "source_freshness_minutes": 180,
  "stale_policy": "MARK_STALE_READ_ONLY_DO_NOT_PROMOTE",
  "safety": {
    "RESEARCH_ONLY": true,
    "SHADOW_ONLY": true,
    "NOT_APPROVED": true,
    "ORDERS": 0,
    "REAL_CAPITAL": 0,
    "ENGINE_FEED": false
  },
  "forbidden": [
    "commit_generated_status",
    "mutate_active_workflow",
    "mutate_existing_schedule",
    "mutate_runtime_pointer",
    "mutate_existing_ledger",
    "alter_clock_or_counter",
    "retune",
    "backfill",
    "read_partial_blind_holdout_economics",
    "orders",
    "real_capital",
    "engine_feed"
  ]
}
