{
  "contract_version": "1.1",
  "mode": "SHADOW_ACTIVE_SCHEDULED",
  "purpose": "Keep QRDS research families moving through the preregister/test/falsify/replicate/freeze flow without mutating active or frozen tracks.",
  "source_of_truth": "tools/gate_btc_research_factory_status.json",
  "runner": "tools/gate_btc_factory/run_factory.py",
  "output": "tools/gate_btc_factory/FACTORY_STATUS_LATEST.json",
  "workflow": ".github/workflows/gate-btc-factory-shadow.yml",
  "routes": {
    "OPEN_DISCOVERY": {
      "owner": "QRDS-LAB",
      "flow": ["PREREGISTER", "TEST", "FALSIFY_OR_REPLICATE", "REJECT_OR_FREEZE"],
      "may_create_new_family": true,
      "partial_holdout_feedback": false
    },
    "DATA_BLOCKED": {
      "owner": "QRDS-DATA",
      "flow": ["DIAGNOSE", "AUDITABLE_SOURCE", "FAIL_CLOSED_INGESTION", "QA", "RESUME_OR_DATA_GAP"],
      "economic_retune": false,
      "synthetic_backfill": false
    },
    "SURVIVOR_MONITORING": {
      "owner": "QRDS-VALIDATE",
      "flow": ["VERIFY_FREEZE_EVIDENCE", "SEPARATE_BLIND_HANDOFF", "MONITOR"],
      "retune": false,
      "backfill": false
    },
    "FROZEN_PROSPECTIVE": {
      "owner": "QRDS-GUARD",
      "flow": ["CLOCK_OR_LEDGER_CONTINUATION_ONLY"],
      "new_family_creation": false,
      "retune": false
    },
    "CLOSED_NULL": {
      "owner": "QRDS-GUARD",
      "flow": ["PRESERVE_REJECTION"],
      "reopen_only_if": "MATERIALLY_DIFFERENT_MECHANISM_OR_DATA"
    },
    "INFRA_ONLY": {
      "owner": "QRDS-DATA",
      "flow": ["MAINTAIN_INFRASTRUCTURE_ONLY"],
      "economic_search": false
    }
  },
  "specialist_non_duplication": {
    "B3_H1": "MONITOR_ONLY",
    "B3_H40_PLUS": "SPECIALIST_OWNED_DISCOVERY_CONTINUES; FACTORY_MUST_NOT_DUPLICATE_OR_RETUNE"
  },
  "activation": {
    "shadow_runner_enabled": true,
    "factory_owned_workflow_enabled": true,
    "factory_owned_schedule_enabled": true,
    "factory_owned_schedule": "17 */6 * * *",
    "push_refresh_enabled": true,
    "manual_dispatch_enabled": true,
    "existing_active_workflows_mutated": false,
    "existing_active_schedules_mutated": false,
    "active_path_rollout_enabled": false,
    "replace_daily_collection": false,
    "redirect_runtime_pointer": false,
    "engine_feed": false,
    "orders": 0,
    "real_capital": 0
  },
  "workflow_write_policy": {
    "repository_permissions": "contents:read",
    "commits_generated_status": false,
    "artifact_only": true,
    "allowed_checkout_diff": ["tools/gate_btc_factory/FACTORY_STATUS_LATEST.json"],
    "protected_path_mutation": false
  },
  "fail_closed": "Any ambiguity in classification, provenance, freeze evidence, causality or source status blocks the transition and leaves the source track unchanged."
}
