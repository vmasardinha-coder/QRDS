{
  "schema": "qrds.factory.xawinwdo_regime_005.prereg.v1",
  "family_id": "XAWINWDO_REGIME_005",
  "status": "PREREGISTERED_CAPACITY_FIT_NO_ECONOMICS",
  "purpose": "Independent capacity-fit generation using only previously observed physical-session capacity; no economic outcomes used to choose design.",
  "source": "MT5_TERMINAL_AUTHORIZED_EXPERIMENTAL_XAWINWDO_ONLY",
  "source_selection": {
    "physical_m5_only": true,
    "exact_expiry_contracts_only": true,
    "synthetic_or_continuous_forbidden": true,
    "no_interpolation": true,
    "no_backfill": true,
    "coverage_block_selection": "largest contiguous synchronized WIN_WDO physical-session block; ties choose earliest block",
    "coverage_selection_may_not_read_returns_or_economic_outcomes": true
  },
  "scientific_contract": {
    "contract_selection": "t_minus_1_liquidity",
    "same_day_liquidity_forbidden": true,
    "return_rule": "log_close_to_close_no_synthetic_returns_across_rolls",
    "known_gap_policy": "drop_only",
    "synchronize_win_wdo": true,
    "horizons": [
      "intraday_bar",
      "1_session",
      "5_sessions",
      "20_sessions",
      "60_sessions"
    ],
    "rolling_dependence_windows": [
      20,
      60
    ],
    "lead_lag_steps": [
      -12,
      -6,
      -3,
      -1,
      0,
      1,
      3,
      6,
      12
    ],
    "metrics": [
      "Pearson",
      "Spearman",
      "sign_concordance",
      "tail_quadrant_frequency"
    ],
    "targets": [
      "next_bar_WIN",
      "next_bar_WDO",
      "next_session_WIN",
      "next_session_WDO"
    ],
    "split": "50_30_20_chronological",
    "embargo_sessions": 20,
    "candidate_freeze_before_validation": true,
    "discovery_only_in_discovery_partition": true,
    "validation_untouched_until_candidate_freeze": true,
    "holdout_only_if_validation_passes": true,
    "rejection_ends_without_retune": true,
    "survivor_to_separate_blinded_prospective_only": true,
    "retroactive_prospective_credit": 0
  },
  "independence": {
    "capacity_only_design_inputs": [
      "largest_contiguous_physical_sessions=168",
      "004 failed because 60-session embargo emptied validation"
    ],
    "economic_outcomes_read_for_design": false,
    "no_credit_transfer_from_prior_generations": true
  },
  "admission": {
    "capacity_first_before_economics": true,
    "outcome_based_design_selection_forbidden": true
  },
  "credit": {
    "scientific_credit_before_validation": 0,
    "prospective_credit": 0,
    "historical_backfill_credit": 0
  },
  "safety": {
    "RESEARCH_ONLY": true,
    "SHADOW_ONLY": true,
    "NOT_APPROVED": true,
    "ENGINE_FEED": false,
    "ORDERS": 0,
    "REAL_CAPITAL": 0,
    "NO_RETUNE": true,
    "NO_BACKFILL": true,
    "NO_COUNTER_RESET": true,
    "FAIL_CLOSED": true,
    "H1_H31_ISOLATED": true
  }
}
