  "purpose": "Isolated momentum challenger based on persistence of cross-sectional 30-close leadership across strictly historical cutoffs; materially distinct from M1 blended 14/30 momentum and M2 BTC-relative return/volatility momentum.",
  "design_input_prohibitions": {
    "m1_m2_economic_ledger_read_for_design": false,
    "empiricus_delta_may_tune": false,
    "delta_internal_tracks_may_tune": false,
    "future_returns_may_tune": false,
    "retrospective_winner_selection": false
  },
  "input_contract": {
    "source": "canonical append-only Momentum M1/M2 prospective snapshots",
    "required_row_block": "m1.rows",
    "required_fields": ["asset", "r30"],
    "cutoff_semantics": "completed UTC daily close only",
    "cutoffs": ["t", "t_minus_7_completed_closes", "t_minus_14_completed_closes"],
    "common_universe_only": true,
    "minimum_common_assets": 30,
    "missing_any_required_cutoff_or_r30": "EXCLUDE_ASSET_BEFORE_RANKING",
    "fewer_than_minimum_common_assets": "FAIL_CLOSED_NO_SIGNAL",
    "duplicate_asset_at_any_cutoff": "FAIL_CLOSED_NO_SIGNAL",
    "source_snapshot_hash_mismatch": "FAIL_CLOSED_NO_SIGNAL",
    "m1_or_m2_score_not_used": true,
    "m1_m2_economic_ledger_forbidden": true
  },
  "formula": {
    "base_measure": "R30_i_s = P_i_s/P_i_s_minus_30_completed_closes - 1, read only from the already-canonical source snapshot",
    "cross_sectional_rank": "For each required cutoff s, rank R30 descending over the exact common universe. Ties are broken lexicographically by asset symbol ascending only for deterministic ordinal output.",
    "percentile": "pct_i_s = 1 - (rank_i_s - 1)/(N - 1), where rank 1 is best and N is exact common-universe size; N must be >=30.",
    "persistence_mean": "mean_pct_i = arithmetic_mean(pct_i_t, pct_i_t_minus_7, pct_i_t_minus_14)",
    "persistence_instability": "instability_i = population_standard_deviation(pct_i_t, pct_i_t_minus_7, pct_i_t_minus_14)",
    "M3": "mean_pct_i - 0.50 * instability_i",
    "ranking": "M3 descending; exact ties broken lexicographically by asset symbol ascending",
    "no_display_clip": true
  },
  "economic_shadow_contract": {
    "selection": "TOP_10_M3",
    "weighting": "EQUAL_WEIGHT",
    "rebalance": "EVERY_7_COMPLETED_UTC_DAILY_CLOSES_FROM_FIRST_M3_ECONOMIC_ACTIVATION",
